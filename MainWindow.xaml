<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SyncDroidWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SyncDroidWinUI"
    xmlns:views="using:SyncDroidWinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SyncDroid"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0" VerticalAlignment="Stretch">
            <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="ms-appx:///Assets/AppIcon.png" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="SyncDroid" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="0.2.0.0 beta"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"/>
                </Border>
                <TextBlock
                    Grid.Column="3"
                    x:Name="SubtitleTextBlock"
                    Text="Android ADB Mirror Sync"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0"
                    TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1"/>
    </Grid>
</Window>
