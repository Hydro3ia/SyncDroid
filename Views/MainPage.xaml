<Page
    x:Class="SyncDroidWinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SyncDroidWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Device Connection & Settings Bar -->
        <Border
            Grid.Row="0"
            Margin="16,4,16,8"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*" MinWidth="200" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8EA;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Loc.AndroidDeviceLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8" Fill="IndianRed" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>

                <ComboBox
                    Grid.Column="1"
                    x:Name="DeviceComboBox"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="{Binding Loc.NoDevicePlaceholder, Mode=OneWay}"
                    SelectionChanged="DeviceComboBox_SelectionChanged"
                    VerticalAlignment="Center"/>

                <Button
                    Grid.Column="2"
                    x:Name="DisconnectDeviceButton"
                    Click="DisconnectDevice_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="{Binding Loc.DisconnectDeviceTooltip, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        <TextBlock Text="{Binding Loc.DisconnectDeviceButton, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Click="RefreshAdb_Click" VerticalAlignment="Center" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                        <TextBlock Text="{Binding Loc.RefreshAdbButton, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Click="WirelessConnect_Click" VerticalAlignment="Center" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE701;" FontSize="13"/>
                        <TextBlock Text="{Binding Loc.WirelessConnectButton, Mode=OneWay}"/>
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="6"
                    Click="ConnectionHelpButton_Click"
                    ToolTipService.ToolTip="{Binding Loc.ConnectionHelpTooltip, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Padding="10,6">
                    <FontIcon Glyph="&#xE897;" FontSize="14"/>
                </Button>

                <Button Grid.Column="7" Click="SettingsButton_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="{Binding Loc.SettingsButton, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Sync & Direct Transfer Tabs -->
        <TabView
            x:Name="MainTabView"
            Grid.Row="1"
            Margin="8,0,8,0"
            IsAddTabButtonVisible="False"
            TabWidthMode="SizeToContent">
            <TabView.TabItems>
                <TabViewItem Header="{Binding Loc.TabPcToAndroid, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Upload"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="PcToAndroidFrame"/>
                </TabViewItem>

                <TabViewItem Header="{Binding Loc.TabAndroidToPc, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Download"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="AndroidToPcFrame"/>
                </TabViewItem>

                <TabViewItem Header="{Binding Loc.TabDirectTransfer, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Send"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="DirectTransferFrame"/>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

        <!-- Embedded Settings Page -->
        <local:SettingsPage x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"/>
    </Grid>
</Page>
