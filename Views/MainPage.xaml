<Page
    x:Class="SyncDroidWinUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SyncDroidWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TopBarResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DeviceComboColumn.Width" Value="3*"/>
                        <Setter Target="DeviceComboColumn.MinWidth" Value="180"/>
                        <Setter Target="DeviceComboColumn.MaxWidth" Value="360"/>
                        <Setter Target="TopBarSpacerColumn.Width" Value="1*"/>
                        <Setter Target="DeviceActionButtonsPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="DeviceActionButtonsPanel.(Grid.Column)" Value="2"/>
                        <Setter Target="DeviceActionButtonsPanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="DeviceActionButtonsPanel.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DeviceComboColumn.Width" Value="*"/>
                        <Setter Target="DeviceComboColumn.MinWidth" Value="140"/>
                        <Setter Target="DeviceComboColumn.MaxWidth" Value="9999"/>
                        <Setter Target="TopBarSpacerColumn.Width" Value="0"/>
                        <Setter Target="DeviceActionButtonsPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="DeviceActionButtonsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="DeviceActionButtonsPanel.(Grid.ColumnSpan)" Value="6"/>
                        <Setter Target="DeviceActionButtonsPanel.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Device Connection & Settings Bar -->
        <Border
            Grid.Row="0"
            Margin="16,4,16,8"
            Padding="16,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="8" ColumnSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="DeviceComboColumn" Width="3*" MinWidth="180" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="TopBarSpacerColumn" Width="1*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8EA;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Loc.AndroidDeviceLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8" Fill="IndianRed" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>

                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    x:Name="DeviceComboBox"
                    DisplayMemberPath="Name"
                    SelectedValuePath="Id"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="{Binding Loc.NoDevicePlaceholder, Mode=OneWay}"
                    SelectionChanged="DeviceComboBox_SelectionChanged"
                    VerticalAlignment="Center"/>

                <StackPanel
                    x:Name="DeviceActionButtonsPanel"
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="DisconnectDeviceButton"
                        Click="DisconnectDevice_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="{Binding Loc.DisconnectDeviceTooltip, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            <TextBlock Text="{Binding Loc.DisconnectDeviceButton, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>

                    <Button Click="RefreshAdb_Click" VerticalAlignment="Center" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="{Binding Loc.RefreshAdbButton, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>

                    <Button Click="WirelessConnect_Click" VerticalAlignment="Center" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE701;" FontSize="13"/>
                            <TextBlock Text="{Binding Loc.WirelessConnectButton, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    Click="ConnectionHelpButton_Click"
                    ToolTipService.ToolTip="{Binding Loc.ConnectionHelpTooltip, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Padding="10,6">
                    <FontIcon Glyph="&#xE897;" FontSize="14"/>
                </Button>

                <Button Grid.Row="0" Grid.Column="5" Click="SettingsButton_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock Text="{Binding Loc.SettingsButton, Mode=OneWay}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Sync & Direct Transfer Tabs -->
        <TabView
            x:Name="MainTabView"
            Grid.Row="1"
            Margin="8,0,8,0"
            IsAddTabButtonVisible="False"
            TabWidthMode="SizeToContent">
            <TabView.TabItems>
                <TabViewItem Header="{Binding Loc.TabPcToAndroid, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Upload"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="PcToAndroidFrame"/>
                </TabViewItem>

                <TabViewItem Header="{Binding Loc.TabAndroidToPc, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Download"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="AndroidToPcFrame"/>
                </TabViewItem>

                <TabViewItem Header="{Binding Loc.TabDirectTransfer, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <SymbolIconSource Symbol="Send"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="DirectTransferFrame"/>
                </TabViewItem>

                <TabViewItem x:Name="ReceiveTabItem" Header="{Binding Loc.TabReceive, Mode=OneWay}" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE896;"/>
                    </TabViewItem.IconSource>
                    <Frame x:Name="ReceiveFrame"/>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

        <!-- Embedded Settings Page -->
        <local:SettingsPage x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"/>

        <!-- Embedded Manage Authenticated Devices Page -->
        <local:ManageDevicesPage x:Name="ManageDevicesView" Grid.Row="1" Visibility="Collapsed"/>
    </Grid>
</Page>
