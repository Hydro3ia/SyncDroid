<Page
    x:Class="SyncDroidWinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SyncDroidWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="16,8,16,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Stretch">

            <!-- Header with Back Button -->
            <Grid ColumnSpacing="12" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BackButton_Click" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                        <TextBlock Text="{Binding Loc.BackToSyncButton, Mode=OneWay}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Loc.SettingsPageTitle, Mode=OneWay}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
            </Grid>

            <!-- Card 1: Language Selection -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xF2B7;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc.LanguageSectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Loc.LanguageSectionDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ComboBox
                        Grid.Column="2"
                        x:Name="LanguageComboBox"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                        <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Card 2: Wireless Companion Service Configuration -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE701;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc.CompanionSectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Loc.CompanionSectionDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            x:Name="CompanionServerToggle"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="CompanionServerToggle_Toggled"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Loc.CompanionPortLabel, Mode=OneWay}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                        <TextBox
                            Grid.Column="1"
                            x:Name="CompanionPortTextBox"
                            Text="45821"
                            FontFamily="Consolas"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="2"
                            Click="ApplyCompanionServer_Click"
                            Padding="12,6"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                <TextBlock Text="{Binding Loc.CompanionRestartServerButton, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock
                            Grid.Column="3"
                            x:Name="CompanionStatusText"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Local LAN IP Endpoint Preview -->
                    <Border
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Loc.CompanionLocalIpLabel, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="1"
                                x:Name="LocalIpEndpointText"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>

                            <Button Grid.Column="2" Click="CopyLocalEndpoint_Click" Padding="10,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                                    <TextBlock Text="{Binding Loc.CopyIpButton, Mode=OneWay}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: LocalSend Protocol Configuration -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc.LocalSendSectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Loc.LocalSendSectionDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            x:Name="LocalSendServerToggle"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="LocalSendServerToggle_Toggled"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Loc.LocalSendReceiveDirLabel, Mode=OneWay}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                            <TextBlock
                                Grid.Column="1"
                                x:Name="LocalSendStatusText"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="12"/>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="LocalSendReceiveDirTextBox"
                                Grid.Column="0"
                                TextChanged="LocalSendReceiveDirTextBox_TextChanged"/>

                            <Button
                                Grid.Column="1"
                                Click="BrowseLocalSendReceiveDir_Click"
                                Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                    <TextBlock Text="{Binding Loc.BrowseButton, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: ADB Directory Configuration -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc.AdbSectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Loc.AdbSectionDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <StackPanel Spacing="10" Margin="4,0,0,0">
                        <RadioButton
                            x:Name="UseBuiltInAdbRadio"
                            GroupName="AdbModeGroup"
                            Content="{Binding Loc.AdbOptionBuiltInOrRunning, Mode=OneWay}"
                            Checked="AdbModeRadio_Checked"/>

                        <RadioButton
                            x:Name="UsePathAdbRadio"
                            GroupName="AdbModeGroup"
                            Content="{Binding Loc.AdbOptionPath, Mode=OneWay}"
                            Checked="AdbModeRadio_Checked"/>

                        <RadioButton
                            x:Name="UseCustomAdbRadio"
                            GroupName="AdbModeGroup"
                            Content="{Binding Loc.AdbOptionCustom, Mode=OneWay}"
                            Checked="AdbModeRadio_Checked"/>

                        <!-- Custom ADB Path Input Row -->
                        <StackPanel x:Name="CustomAdbPanel" Spacing="6" Margin="28,4,0,0">
                            <TextBlock Text="{Binding Loc.AdbCustomDirLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="CustomAdbDirTextBox"
                                    Grid.Column="0"
                                    PlaceholderText="{Binding Loc.AdbCustomDirPlaceholder, Mode=OneWay}"
                                    TextChanged="CustomAdbDirTextBox_TextChanged"/>

                                <Button
                                    x:Name="BrowseAdbDirButton"
                                    Grid.Column="1"
                                    Click="BrowseAdbDir_Click"
                                    Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                        <TextBlock Text="{Binding Loc.BrowseButton, Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- Kill Built-in ADB Process on Exit Toggle -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc.AdbKillBuiltInOnExitTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Loc.AdbKillBuiltInOnExitDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            x:Name="KillBuiltInAdbOnExitToggle"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Toggled="KillBuiltInAdbOnExitToggle_Toggled"/>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <!-- Verify ADB Button & Status -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="VerifyAdb_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="{Binding Loc.TestAdbButton, Mode=OneWay}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock
                            Grid.Column="1"
                            x:Name="AdbStatusText"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 5: Post-Transfer Hash Verification -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="38"
                        Height="38"
                        CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc.HashVerifySectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Loc.HashVerifySectionDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ToggleSwitch
                        Grid.Column="2"
                        x:Name="VerifyHashToggle"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        Toggled="VerifyHashToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Card 5: About This App -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,18">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/AppIcon.png" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Loc.AboutSectionTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Loc.AboutAppVersion, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Loc.AboutAppDescription, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Loc.AboutDeveloperInfo, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <HyperlinkButton
                                Content="{Binding Loc.AboutGithubLinkText, Mode=OneWay}"
                                NavigateUri="https://github.com/Hydro3ia/SyncDroid"
                                Padding="8,4"
                                FontSize="12"/>
                            <HyperlinkButton
                                Content="{Binding Loc.AboutPrivacyLinkText, Mode=OneWay}"
                                NavigateUri="https://github.com/Hydro3ia/SyncDroid/blob/main/PRIVACY.md"
                                Padding="8,4"
                                FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
