<ContentDialog
    x:Class="SyncDroidWinUI.Views.AndroidFolderPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SyncDroidWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{Binding DialogTitle, Mode=OneWay}"
    PrimaryButtonText="{Binding PrimaryActionText, Mode=OneWay}"
    CloseButtonText="{Binding Loc.CancelButton, Mode=OneWay}"
    DefaultButton="Primary">

    <Grid Width="540" Height="450" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Device info + Refresh + New Folder Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8EA;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DeviceNameText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                <ProgressRing x:Name="LoadingRing" Width="14" Height="14" IsActive="False" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>

            <Button x:Name="NewFolderToggleBtn" Grid.Column="1" Click="NewFolderToggle_Click" Padding="10,5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8F4;" FontSize="12"/>
                    <TextBlock Text="{Binding Loc.NewFolderButton, Mode=OneWay}" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Click="RefreshTree_Click" Padding="10,5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                    <TextBlock Text="{Binding Loc.RefreshTreeButton, Mode=OneWay}" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 1: Inline New Folder Bar (Collapsible) -->
        <Border
            x:Name="NewFolderBar"
            Grid.Row="1"
            Visibility="Collapsed"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NewFolderNameBox"
                    Grid.Column="0"
                    PlaceholderText="{Binding Loc.NewFolderPlaceholder, Mode=OneWay}"/>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CreateNewFolder_Click"
                    Padding="12,5">
                    <TextBlock Text="{Binding Loc.CreateButton, Mode=OneWay}" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- Row 2: Storage Folder TreeView -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4">
            <TreeView
                x:Name="StorageTreeView"
                SelectionMode="Single"
                Expanding="StorageTreeView_Expanding"
                ItemInvoked="StorageTreeView_ItemInvoked">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="2,3">
                            <FontIcon Glyph="{Binding Content.IconGlyph}" FontSize="15" Foreground="{Binding Content.IconColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Content.DisplayName}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- Row 3: Selected Path Preview -->
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="{Binding Loc.SelectedPathLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox
                x:Name="SelectedPathBox"
                FontFamily="Consolas"
                FontSize="12"
                Text="/storage/emulated/0"/>
            <TextBlock
                x:Name="ErrorStatusText"
                FontSize="12"
                Foreground="IndianRed"
                Visibility="Collapsed"
                TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</ContentDialog>
